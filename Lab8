entity fifo8x8 is
    Port ( clk : in STD_LOGIC;
           rst : in STD_LOGIC;
           data_in : in STD_LOGIC_VECTOR (7 downto 0);
           wrinc : in STD_LOGIC;
           rdinc : in STD_LOGIC;
           data_out : out STD_LOGIC_VECTOR (7 downto 0));
end fifo8x8;

architecture Behavioral of fifo8x8 is
type reg_array_t is array (0 to 7) of STD_LOGIC_VECTOR(7 downto 0);
    signal fifo    : reg_array_t := (others => (others => '0'));
    signal wrptr   : unsigned(2 downto 0) := (others => '0');
    signal rdptr   : unsigned(2 downto 0) := (others => '0');
    signal dec_out : STD_LOGIC_VECTOR(7 downto 0);
    signal mux_out : STD_LOGIC_VECTOR(7 downto 0);
begin
process(clk)
    begin
      if rising_edge(clk) then
         if rst = '1' then
          wrptr <= (others => '0');
         elsif wrinc = '1' then
            wrptr <= wrptr + 1;
         end if;
      end if;
    end process;
    
process(clk)
    begin
     if rising_edge(clk) then
       if rst = '1' then
         rdptr <= (others => '0');
        elsif rdinc = '1' then
           rdptr <= rdptr + 1;
       end if;
     end if;
 end process;
    
process(wrptr)
    begin
       dec_out <= (others => '0');
      dec_out(to_integer(wrptr)) <= '1';
end process;
    
process(clk)
    begin
     if rising_edge(clk) then
       if rst = '1' then
         fifo <= (others => (others => '0'));
       else
         for i in 0 to 7 loop
           if (dec_out(i) = '1' and wrinc = '1') then
             fifo(i) <= data_in;
            end if;
         end loop;
       end if;
     end if;
end process;

process(fifo, rdptr)
    begin
        mux_out <= fifo(to_integer(rdptr));
    end process;

process(clk)
    begin
      if rising_edge(clk) then
        if rst = '1' then
          data_out <= (others => '0');
         elsif rdinc = '1' then
           data_out <= mux_out;
        end if;
      end if;
end process;
end Behavioral;



