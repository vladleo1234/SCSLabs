entity fifo_control is
    Port ( clk : in STD_LOGIC;
           rst : in STD_LOGIC;
           rd : in STD_LOGIC;
           wr : in STD_LOGIC;
           rdinc : out STD_LOGIC;
           wrinc : out STD_LOGIC;
           empty : out STD_LOGIC;
           full : out STD_LOGIC);
end fifo_control;

architecture Behavioral of fifo_control is
    signal count : unsigned(3 downto 0) := (others => '0');
    signal empty_int : STD_LOGIC;
    signal full_int : STD_LOGIC;
    signal rdinc_int : STD_LOGIC;
    signal wrinc_int : STD_LOGIC;
begin
    empty_int <= '1' when count = 0 else '0';
    full_int  <= '1' when count = 8 else '0';
    
    rdinc_int <= '1' when (rd = '1' and empty_int = '0') else '0';
   wrinc_int <= '1' when (wr = '1' and full_int = '0')  else '0';
    
   empty <= empty_int;
  full  <= full_int;
   rdinc <= rdinc_int;
   wrinc <= wrinc_int;

process(clk)
    begin
      if rising_edge(clk) then
        if rst = '1' then
          count <= (others => '0');
         else
            if wrinc_int = '1' and rdinc_int = '0' then
              count <= count + 1;
            elsif rdinc_int = '1' and wrinc_int = '0' then
               count <= count - 1;
             end if;
        end if;
     end if;
    end process;
end Behavioral;





