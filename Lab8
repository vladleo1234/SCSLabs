architecture Behavioral of Tb_fifo_full is
    component fifo_control is
        Port (
            clk   : in  STD_LOGIC;
            rst   : in  STD_LOGIC;
            rd    : in  STD_LOGIC;
            wr    : in  STD_LOGIC;
            rdinc : out STD_LOGIC;
            wrinc : out STD_LOGIC;
            empty : out STD_LOGIC;
            full  : out STD_LOGIC
        );
    end component;

    component fifo8x8 is
        Port (
            clk      : in  STD_LOGIC;
            rst      : in  STD_LOGIC;
            data_in  : in  STD_LOGIC_VECTOR (7 downto 0);
            wrinc    : in  STD_LOGIC;
            rdinc    : in  STD_LOGIC;
            data_out : out STD_LOGIC_VECTOR (7 downto 0)
        );
    end component;

    signal clk      : STD_LOGIC := '0';
    signal rst      : STD_LOGIC := '0';
    signal rd       : STD_LOGIC := '0';
    signal wr       : STD_LOGIC := '0';
    signal rdinc    : STD_LOGIC;
    signal wrinc    : STD_LOGIC;
    signal empty    : STD_LOGIC;
    signal full     : STD_LOGIC;
    signal data_in  : STD_LOGIC_VECTOR(7 downto 0) := (others => '0');
    signal data_out : STD_LOGIC_VECTOR(7 downto 0);
begin
    ctrl_inst: fifo_control port map (
        clk   => clk,
        rst   => rst,
        rd    => rd,
        wr    => wr,
        rdinc => rdinc,
        wrinc => wrinc,
        empty => empty,
        full  => full
    );

    dp_inst: fifo8x8 port map (
        clk      => clk,
        rst      => rst,
        data_in  => data_in,
        wrinc    => wrinc,
        rdinc    => rdinc,
        data_out => data_out
    );

    clk <= not clk after 5 ns;

    stim: process
    begin

        rst <= '1';
        wait for 20 ns;
        wait until rising_edge(clk);
        rst <= '0';
        wait until rising_edge(clk);

        
        for i in 1 to 8 loop
            data_in <= std_logic_vector(to_unsigned(i * 17, 8));
            wr <= '1';
            wait until rising_edge(clk);
        end loop;
        wr <= '0';
        data_in <= (others => '0');
        wait until rising_edge(clk);


        data_in <= x"99";
        wr <= '1';
        wait until rising_edge(clk);
        wr <= '0';
        data_in <= (others => '0');
        wait until rising_edge(clk);

        
        for i in 1 to 8 loop
            rd <= '1';
            wait until rising_edge(clk);
        end loop;
        rd <= '0';
        wait until rising_edge(clk);

      
        rd <= '1';
        wait until rising_edge(clk);
        rd <= '0';
        wait until rising_edge(clk);

        for i in 1 to 5 loop
            data_in <= std_logic_vector(to_unsigned(16#A0# + i, 8));
            wr <= '1';
            wait until rising_edge(clk);
        end loop;
        wr <= '0';

        for i in 1 to 3 loop
            rd <= '1';
            wait until rising_edge(clk);
        end loop;
        rd <= '0';

        for i in 1 to 5 loop
            data_in <= std_logic_vector(to_unsigned(16#B0# + i, 8));
            wr <= '1';
            wait until rising_edge(clk);
        end loop;
        wr <= '0';
        data_in <= (others => '0');
        wait until rising_edge(clk);

       
        for i in 1 to 2 loop
            data_in <= std_logic_vector(to_unsigned(16#C0# + i, 8));
            rd <= '1';
            wr <= '1';
            wait until rising_edge(clk);
        end loop;
        rd <= '0';
        wr <= '0';
        data_in <= (others => '0');

       
        for i in 1 to 7 loop
            rd <= '1';
            wait until rising_edge(clk);
        end loop;
        rd <= '0';

        wait;
    end process;
end Behavioral;




